<?xml version="1.0"?>
<!-- ROS 2 패키지 메타데이터: 빌드 도구·필수 의존성·패키지 정보 -->
<package format="3">
  <name>art_job_manager</name>
  <version>0.2.0</version>
  <description>A4 persistent ROS 2 job manager with real DrawingController Action integration.</description>
  <maintainer email="maintainer@example.invalid">A4 Team</maintainer>
  <license>UNLICENSED</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>unique_identifier_msgs</exec_depend>
  <exec_depend>art_interfaces</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
