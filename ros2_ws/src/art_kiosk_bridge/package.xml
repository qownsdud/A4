<?xml version="1.0"?>
<!-- ROS 2 패키지 메타데이터: 빌드 도구·필수 의존성·패키지 정보 -->
<package format="3">
  <name>art_kiosk_bridge</name>
  <version>0.1.0</version>
  <description>Independent HTTP-to-ROS 2 bridge for A4 drawing jobs.</description>
  <maintainer email="maintainer@example.invalid">A4 Team (replace before release)</maintainer>
  <license>UNLICENSED</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>art_interfaces</exec_depend>
